{
    // 配置格式版本，与 src/Config/Config.h 中的字段保持一致。
    "version": 1,

    // 日志级别：Off、Fatal、Error、Warn、Info、Debug、Trace。
    "logLevel": "Info",

    // 界面及日志语言，对应 lang 目录中的语言文件名（不含扩展名）。
    "language": "zh_CN",

    "command": {
        // 注册 /pos1、/pos2、/size 和 /desel 短命令。
        "shortCommands": true,
        // 将已支持的 // 命令交给 /cx 处理。
        "chatDoubleSlash": true
    },
    "limits": {
        // 单个长方体选区可包含的最大方块数（含两个角点）。
        "maxSelectionVolume": 8000000
    }
}
